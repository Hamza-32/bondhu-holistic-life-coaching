# Copy to .env.local and fill in from Supabase Dashboard → Connect / API Keys.
# Both values are public by design (protected by Row Level Security).
# NEVER put the service_role / secret key in any VITE_ variable.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Public site URL used for Open Graph tags, canonical links, robots.txt and sitemap.xml.
# Use your deployment origin in Vercel; use localhost for local development.
VITE_SITE_URL=http://localhost:3000
